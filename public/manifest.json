{
    "manifest_version": 3,
    "name": "Dark mode",
    "description": "Convert any website theme into dark mode",
    "version": "1.0.0",
    "action":{
        "default_icon":"icon.png",
        "default_title":"Dark Mode",
        "default_popup":"index.html"
    },
    "permissions": ["activeTab", "scripting"],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [{
        "matches": ["http://*/*", "https://*/*", "<all_urls>"],
        "js": [
                "./content.js"
            ]
    }],
    "icons":{
        "128":"icon.png"
    }
}